{
  "name": "evernote-exporter",
  "version": "0.3.1",
  "description": "Export Evernote data to a portable neutral format for migration to any notes system",
  "main": "src/index.js",
  "bin": {
    "evernote-exporter": "src/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test",
    "start": "node src/web/server.js",
    "start:phone": "node src/web/server.js --share",
    "cli": "node src/cli.js",
    "package": "node scripts/build-release.js"
  },
  "files": [
    "src",
    "scripts",
    "Start Evernote Archive.cmd",
    "Start on iPhone.cmd",
    "Backup Windows Evernote.cmd",
    "Export Windows Backup.cmd",
    "README.md",
    "docs/user-guide.md",
    "docs/archive-format.md",
    "START HERE.md",
    "START HERE.html",
    "docs/source-safety.md",
    "docs/windows-backup.md"
  ],
  "license": "MIT",
  "dependencies": {
    "entities": "6.0.1",
    "saxes": "6.0.0",
    "yazl": "3.3.1",
    "yjs": "13.6.31"
  }
}
